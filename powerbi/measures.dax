Active Employees =
CALCULATE(COUNTROWS(Employees), Employees[status] = "Active")

Eligible Hires =
COUNTROWS(Employees)

Terminated Employees =
CALCULATE(COUNTROWS(Employees), Employees[status] = "Terminated")

Cumulative Exit Share =
DIVIDE([Terminated Employees], [Eligible Hires])

Average Completed Tenure =
AVERAGEX(FILTER(Employees, Employees[status] = "Terminated"), DIVIDE(DATEDIFF(Employees[hire_date], Employees[termdate], DAY), 365.2425))

Closing Headcount =
VAR Y = SELECTEDVALUE('Year'[year]) VAR Cutoff = MIN(DATE(Y, 12, 31), MAXX(ALL(Employees), Employees[as_of_date])) RETURN IF(NOT ISBLANK(Y), CALCULATE(COUNTROWS(Employees), FILTER(Employees, Employees[hire_date] <= Cutoff && (ISBLANK(Employees[termdate]) || Employees[termdate] > Cutoff))))

Annual Hires =
VAR Y = SELECTEDVALUE('Year'[year]) RETURN COUNTROWS(FILTER(Employees, YEAR(Employees[hire_date]) = Y))

Annual Exits =
VAR Y = SELECTEDVALUE('Year'[year]) VAR Cutoff = MAXX(ALL(Employees), Employees[as_of_date]) RETURN COUNTROWS(FILTER(Employees, NOT ISBLANK(Employees[termdate]) && YEAR(Employees[termdate]) = Y && Employees[termdate] <= Cutoff))
